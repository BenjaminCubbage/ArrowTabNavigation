{
    "name": "Arrow Tab Navigation",
    "description": "Navigate Chrome Tabs with Ctrl+Arrow",
    "version": "1.0",
    "manifest_version": 3,
    "permissions": [ "scripting", "activeTab" ],
    "background": {
        "service_worker": "service-worker.js"
    },
    "commands": {
        "tab-next": {
            "suggested_key": "Ctrl+Up",
            "description": "Tab Next"
        },
        "tab-previous": {
            "suggested_key": "Ctrl+Down",
            "description": "Tab Previous"
        }
    }
}